# Docker builds use the repository root as context. Keep credentials and
# machine-local files out of the daemon/build cache; the Go server image copies
# only `go-server/`.

# Version control and IDE state
.git
.gitignore
.gradle/
**/.gradle/
.kotlin/
**/.kotlin/
.idea/
**/.idea/
.lody/
.DS_Store
**/.DS_Store

# Build output and runtime artifacts
build/
**/build/
**/captures/
.data/
**/.data/
kotlin-js-store/
**/kotlin-js-store/
node_modules/
**/node_modules/
*.log
**/*.log
*.db
**/*.db
**/*.db-shm
**/*.db-wal
**/*.db-lck
**/esp32-control-server
**/esp32controlserver

# Secrets and machine-local configuration
local.properties
**/local.properties
.env
**/.env
.env.*
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
