# Copy to server/.env for local runs (server/.env is gitignored).
# Environment variables with the same name take precedence over this file.
# CONFIG_FILE can point at a different file.

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
MQTT_HOST=broker.example.com
MQTT_PORT=1883
# tcp (default) or websocket. Ktor Native has no raw TLS sockets, so use
# websocket + MQTT_TLS=true for TLS-only brokers (EMQX Cloud: port 8084).
MQTT_TRANSPORT=tcp
MQTT_TLS=false
MQTT_WS_PATH=/mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
DATABASE_PATH=esp32-control.db
