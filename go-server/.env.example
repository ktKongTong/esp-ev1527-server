# Copy to go-server/.env for local runs (go-server/.env is gitignored).
# Environment variables with the same name take precedence over this file.
# CONFIG_FILE can point at a different file.

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
MQTT_HOST=broker.example.com
MQTT_PORT=1883
# tcp (default) or websocket. Raw TLS is not part of the gateway contract, so
# use websocket + MQTT_TLS=true for TLS-only brokers (EMQX Cloud: port 8084).
MQTT_TRANSPORT=tcp
MQTT_TLS=false
MQTT_WS_PATH=/mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
DATABASE_PATH=esp32-control.db
GATEWAY_CLIENT_ID=OpenMQTTGateway_ESP32_315M
# debug logs every MQTT frame and HTTP request; use info or higher in production.
LOG_LEVEL=debug
