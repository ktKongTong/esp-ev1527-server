# Copy to .env in the directory where the server runs (go-server/.env when
# started from go-server/). Environment variables with the same name take
# precedence over this file.

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
MQTT_HOST=broker.example.com
MQTT_PORT=1883
# tcp (default) or websocket. Raw TLS is not part of the gateway contract, so
# use websocket + MQTT_TLS=true for TLS-only brokers (EMQX Cloud: port 8084).
MQTT_TRANSPORT=tcp
MQTT_TLS=false
MQTT_WS_PATH=/mqtt
MQTT_USERNAME=
MQTT_PASSWORD=

# Turso Cloud database. DATABASE_URL is accepted as an alias.
# The token is required for Turso Cloud; local sqld can run without one.
TURSO_DATABASE_URL=libsql://example.turso.io
TURSO_AUTH_TOKEN=

GATEWAY_CLIENT_ID=OpenMQTTGateway_ESP32_315M
# debug logs every MQTT frame and HTTP request; use info or higher in production.
LOG_LEVEL=debug
